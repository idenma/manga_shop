<h1><%= @product.title %></h1>
<p>価格: <%= number_to_currency(@product.price, unit: "円", precision: 0) %></p>

<p>
  <%= button_to "購入する", checkout_product_path(@product), method: :post, data: { turbo: false } %>
</p>

<div>
  <h3>添付PDFファイル</h3>
  <% if @product.pdf_file.attached? %>
    <%= link_to "PDFをダウンロード",
      rails_blob_url(@product.pdf_file, disposition: :attachment),
      target: "_blank", rel: "noopener" %>
  <% else %>
    <p>PDFファイルはありません。</p>
  <% end %>
</div>

<hr>
<%= link_to "編集", edit_product_path(@product) %> |
<%= button_to "削除", @product, method: :delete, data: { turbo_confirm: "この商品を削除しますか？" } %>
<%= link_to "一覧に戻る", products_path %>